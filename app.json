{
  "expo": {
    "name": "Printechs ERP Application",
    "slug": "erpnext-mobile",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Enterprise Resource Planning mobile app for managing sales, inventory, receivables, and approvals on the go.",
    "primaryColor": "#667eea",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.printechs.erpnext",
      "buildNumber": "6",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to scan QR codes",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select images",
        "NSLocationWhenInUseUsageDescription": "This app needs location access for territory-based features",
        "NSUserNotificationsUsageDescription": "This app needs notification permission to send you important alerts",
        "NSContactsUsageDescription": "This app uses your contacts so you can choose who receives WhatsApp payment reminders.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": []
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.printechs.erpnext",
      "versionCode": 13,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "erpnext",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-asset"
    ],
    "notification": {
      "color": "#ffffff"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "10aaba16-f1df-41a6-84fe-c543a7596019"
      }
    },
    "owner": "sakmoly2233"
  }
}
